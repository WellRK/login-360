NODE_ENV=development
PORT=3000
# lista separada por vírgula; * libera tudo (só em dev)
CORS_ORIGINS=*
ENABLE_DOCS=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app360
DB_USER=postgres
DB_PASSWORD=postgres

# gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-com-mais-de-32-caracteres
# segundos (3600) ou '1h', '7d'
JWT_EXPIRATION=1d

# usados por: npm run seed
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=TroqueEssaSenha123
